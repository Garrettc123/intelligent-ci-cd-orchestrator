{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "python src/launch.py --profile smoke --output /home/runner/ci-results",
    "cronSchedule": "*/15 * * * *",
    "restartPolicyType": "NEVER"
  }
}
